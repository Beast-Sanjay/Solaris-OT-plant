digraph PurdueLab {
  graph [fontname="DejaVu Sans", bgcolor="white", label="Purdue OT + Active Directory Lab | strict conduits", labelloc=t, fontsize=21, ranksep=0.55, nodesep=0.3, splines=ortho];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, color="#d6d6e3", fillcolor="#f5f4fa"];
  edge [color="#625d9e", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
  l4 [label="L4 ENTERPRISE IT\n10.0.0.0/24\nDC01 (CORP AD) | CA01 | DB01 | IT WS", fillcolor="#ede5ff"];
  wan [label="WAN simulation\n198.18.0.0/24\nOptional attacker terminal", fillcolor="#eee1e1"];
  web [label="WEB DMZ\n10.6.6.0/24\nNginx (isolated)", fillcolor="#f2f4fa"];
  idmz [label="L3.5 INDUSTRIAL DMZ\n10.7.7.0/24\nJump host | AD-check gate | app relays", fillcolor="#ffe7d8"];
  l3 [label="L3 OPERATIONS\n172.18.10.0/24\nHistorian | ICS-DC01 (separate OT AD)", fillcolor="#e7f4fb"];
  l2 [label="L2 SUPERVISORY\n172.18.20.0/24\nSCADA | FUXA HMI", fillcolor="#e6f5e8"];
  l1 [label="L1 CONTROL\n192.168.95.0/24\n11 upstream protocol targets | SIS | PLC demo", fillcolor="#fff2cc"];
  l0 [label="L0 PHYSICAL PROCESS\n192.168.96.0/24\nTank | Pump | Temperature/Flow", fillcolor="#ffe7e7"];
  soc [label="SOC\n192.168.200.0/24\nEvent collector | optional Elastic/Kibana", fillcolor="#e5eefa"];
  {rank=same; web; l4; soc;}
  l4 -> idmz [label="AD-authenticated query"];
  idmz -> l3 [label="historian read-only"];
  l3 -> l2 [label="SCADA read-only"];
  l2 -> l1 [label="Modbus permitted"];
  l1 -> l0 [label="field I/O"];
  l3 -> soc [label="SOC events"];
  wan -> web [label="HTTP allowlisted"];
  web -> l4 [style=invis];
}
